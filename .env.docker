# .env.docker (ROOT - Docker environment variables)
# ============================================================
# EVENT MANAGEMENT - DOCKER ENVIRONMENT
# ============================================================
# Copy this file to .env for Docker Compose
# ============================================================

# Node Environment (development/production)
NODE_ENV=development

# Server
PORT=4000

# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=event_management
DB_PORT=5432

# Redis Configuration (the API reads REDIS_HOST / REDIS_PORT only; there is no password option)
REDIS_PORT=6379

# Sessions are opaque tokens (no JWT secrets). Lifetimes, if you want to change them:
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=7d
# SESSION_MAX_LIFETIME=30d

# Feature Flags
FEATURE_PAYMENT_ENABLED=false
FEATURE_EMAIL_ENABLED=false

# Stripe (Optional - leave empty for mock payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP (Optional - leave empty to disable emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=eventeer-dev@outlook.com

# OAuth (Optional - leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/oauth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/auth/oauth/github/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4000/auth/oauth/facebook/callback


# URLs
FRONTEND_URL=http://localhost:3000
# Web app (Next.js). Public values are baked into the image at build time; leave the Stripe key empty with mock payments.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=