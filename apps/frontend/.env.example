# Copy to .env.local. NEXT_PUBLIC_* values are inlined at BUILD time.

# Where the BROWSER reaches the API. It must share a registrable domain with the web app
# (localhost:3000 <-> localhost:4000 is fine): auth is httpOnly SameSite=Lax cookies.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
# Leave empty for demo checkout (pairs with empty Stripe keys on the API).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only: how the Next.js server (middleware / RSC) reaches the API when that differs
# from the public URL, e.g. http://backend:4000 inside Docker or Kubernetes.
# API_INTERNAL_URL=http://backend:4000
