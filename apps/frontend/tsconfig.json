{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "es2023",
        "lib": ["dom", "dom.iterable", "esnext"],
        "module": "esNext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "jsx": "preserve",
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": ["./src/*"],
            "@packages/shared-schemas": ["../../packages/shared-schemas/src"]
        },
        "allowJs": true,
        "noEmit": true
    },
    "ts-node": {
        "compilerOptions": {
            "module": "CommonJS",
            "moduleResolution": "node"
        }
    },
    "include": [
        "global.d.ts",
        "next-env.d.ts",
        "env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        "eslint.config.js"
    ],
    "exclude": ["node_modules"]
}
