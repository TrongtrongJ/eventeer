{
  "name": "@eventeer/web",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "analyze:bundler": "next experimental-analyze",
    "analyze:bundler:output": "next experimental-analyze --output",
    "build": "next build --webpack",
    "dev": "next dev --port 3000 --webpack",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src e2e playwright.config.ts",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next out",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@orpc/client": "^2.0.0-beta.32",
    "@orpc/contract": "^2.0.0-beta.32",
    "@orpc/openapi": "^2.0.0-beta.32",
    "@orpc/react-query": "^1.15.1",
    "@orpc/server": "^2.0.0-beta.32",
    "@orpc/tanstack-query": "^2.0.0-beta.31",
    "@packages/contract": "workspace:*",
    "@packages/shared-schemas": "workspace:*",
    "@reduxjs/toolkit": "^2.12.0",
    "@stripe/react-stripe-js": "^2.4.0",
    "@stripe/stripe-js": "^2.2.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-next-experimental": "^5.103.1",
    "next": "^16.3.6",
    "next-intl": "^4.14.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-qr-code": "^2.0.12",
    "react-redux": "^9.3.0",
    "socket.io-client": "^4.6.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.3",
    "@packages/eslint-config": "workspace:*",
    "@packages/prettier-config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query-devtools": "^5.90.21",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.16",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.11.0",
    "jsdom": "^28.1.0",
    "msw": "^2.12.10",
    "postcss": "^8.4.32",
    "prettier": "^3.9.8",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.0.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
