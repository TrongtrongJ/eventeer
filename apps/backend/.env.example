# Copy to .env. Every variable here is validated at startup (src/env.validation.ts):
# the API refuses to boot with a clear error if something required is missing or malformed.

NODE_ENV=development
PORT=4000
# Origin of the web app: CORS, OAuth redirects and the CSRF origin check all use it.
# Must be https:// in production (auth cookies are Secure there).
FRONTEND_URL=http://localhost:3000
# Number of reverse proxies in front of the API (ingress/LB) so client IPs are correct.
TRUST_PROXY=0

# --- PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=event_management
DB_SSL=false

# --- Redis (auth cache, queues, rate limits, websocket fan-out)
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Opaque-token sessions (no signing secrets exist: tokens are random and stored hashed)
ACCESS_TOKEN_SECRET=ForTheRomanEmpire
REFRESH_TOKEN_SECRET=ForTheRomanEmpire
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
SESSION_MAX_LIFETIME=30d
MAX_SESSIONS_PER_USER=5
# Self-service ADMIN sign-up. Unset = on in development, off in production.
# ALLOW_ADMIN_SIGNUP=true

# --- Rate limiting (120 req/min/IP globally; auth and booking routes are stricter)
RATE_LIMIT_ENABLED=true

# --- Bookings
# Minutes a PENDING booking holds its seats before they are released.
BOOKING_HOLD_MINUTES=15

# --- Payments. Leave the Stripe keys empty for local MOCK payments (refused in production).
FEATURE_PAYMENT_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email. When disabled, verification/reset links are logged to the console in development.
FEATURE_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@eventeer.local

# --- OAuth (optional). Redirect URIs must point at the API:
#     <api-origin>/auth/oauth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/auth/oauth/github/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4000/auth/oauth/facebook/callback

# --- Circuit breaker around Stripe
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000
CIRCUIT_BREAKER_RESET_TIMEOUT=30000
