# Integration tests run against real Postgres + Redis (see docker-compose.yml).
# Use a dedicated database: the e2e suite truncates tables.
NODE_ENV=test
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=Onmyway123
DB_NAME=event_management_test
REDIS_HOST=localhost
REDIS_PORT=6379
FRONTEND_URL=http://localhost:3000
FEATURE_EMAIL_ENABLED=false
BOOKING_HOLD_MINUTES=15

# Integration tests intentionally hammer endpoints
RATE_LIMIT_ENABLED=false
