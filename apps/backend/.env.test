# Integration tests run against real Postgres + Redis (see docker-compose.yml).
# Use a dedicated database: the e2e suite truncates tables.
NODE_ENV=test
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=Onmyway123
DB_NAME=event_management_test
REDIS_HOST=localhost
REDIS_PORT=6379
FRONTEND_URL=http://localhost:3000
FEATURE_EMAIL_ENABLED=false
BOOKING_HOLD_MINUTES=15

# Integration tests intentionally hammer endpoints
RATE_LIMIT_ENABLED=false

# Image uploads: placeholders only. Presigning is a local computation; the e2e suite swaps the
# object-store calls (HEAD/GET/COPY/DELETE) for an in-memory fake, so nothing here reaches AWS.
S3_BUCKET=example-eventeer-images
S3_REGION=ap-southeast-1
S3_PUBLIC_BASE_URL=https://images.example.com
AWS_ACCESS_KEY_ID=AKIAEXAMPLEPLACEHOLDER
AWS_SECRET_ACCESS_KEY=example-secret-access-key-placeholder
