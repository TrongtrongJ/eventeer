{
  "name": "@eventeer/api",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "seed:demo": "ts-node --transpile-only scripts/seed-db.ts",
    "dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run --reporter verbose",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts --reporter verbose",
    "migration:generate": "nest build && typeorm -d dist/config/data-source.js migration:generate",
    "migration:run": "typeorm -d dist/config/data-source.js migration:run",
    "migration:revert": "typeorm -d dist/config/data-source.js migration:revert",
    "typeorm": "typeorm -d dist/config/data-source.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@apollo/server": "^5.2.0",
    "@as-integrations/express5": "^1.1.2",
    "@liaoliaots/nestjs-redis": "^9.0.5",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bull": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/observe": "^0.3.5",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/platform-socket.io": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/typeorm": "^12.0.0",
    "@nestjs/websockets": "^12.0.0",
    "@node-rs/bcrypt": "^1.10.9",
    "@orpc/nest": "^2.0.0-beta.32",
    "@orpc/server": "^2.0.0-beta.32",
    "@packages/contract": "workspace:*",
    "@packages/shared-schemas": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.6.0",
    "bull": "^4.11.5",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "graphql": "^16.12.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "nodemailer": "^6.9.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.6.0",
    "stripe": "^14.7.0",
    "typeorm": "^0.3.17",
    "uuid": "^14.0.1",
    "zod": "4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@packages/eslint-config": "workspace:*",
    "@packages/prettier-config": "workspace:*",
    "@swc/core": "^1.15.8",
    "@types/bull": "^4.10.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9",
    "@types/ms": "^2",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^6.4.14",
    "@types/passport": "^0",
    "@types/passport-jwt": "^4",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.8",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.0",
    "unplugin-swc": "^1.5.1",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  }
