{
  "name": "@eventeer/api",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "seed:demo": "npx ts-node ./scripts/seed-db.ts",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migration:generate": "typeorm migration:generate -n",
    "migration:run": "typeorm migration:run",
    "migration:revert": "typeorm migration:revert",
    "upgrade": "nest upgrade"
  },
  "dependencies": {
    "@apollo/server": "^5.2.0",
    "@as-integrations/express5": "^1.1.2",
    "@grpc/grpc-js": "^1.14.3",
    "@liaoliaots/nestjs-redis": "^9.0.5",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bull": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/microservices": "^12.0.0",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/platform-socket.io": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^12.0.0",
    "@nestjs/websockets": "^12.0.0",
    "@node-rs/argon2": "^2.2.0",
    "@node-rs/bcrypt": "^1.10.9",
    "@orpc/nest": "^2.0.0-beta.32",
    "@orpc/openapi": "^2.0.0-beta.32",
    "@orpc/server": "^2.0.0-beta.32",
    "@packages/contract": "workspace:*",
    "@packages/shared-schemas": "workspace:*",
    "apollo-server-express": "^3.13.0",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "bull": "^4.11.5",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^17.2.3",
    "graphql": "^16.12.0",
    "ioredis": "^5.3.2",
    "ms": "^2.1.3",
    "nestjs-redoc-try-out": "^1.0.3",
    "nestjs-zod": "^4.0.1",
    "nodemailer": "^6.9.7",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.6.0",
    "stripe": "^14.7.0",
    "typeorm": "^0.3.17",
    "uuid": "^14.0.1",
    "zod": "4.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.6",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@packages/eslint-config": "workspace:*",
    "@packages/prettier-config": "workspace:*",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.8",
    "@types/bcrypt": "^5.0.0",
    "@types/bull": "^4.10.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/ms": "^2",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-jwt": "^3.0.9",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.7",
    "@types/webpack-node-externals": "^3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^30.0.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.8",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2",
    "webpack": "^5.110.2",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "<rootDir>/main.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/configs",
      "^.+\\.(module|guard|strategy)\\.ts$"
    ],
    "moduleNameMapper": {
      "^@auth/(.*)": "<rootDir>/auth/$1",
      "^@common/(.*)": "<rootDir>/common/$1",
      "^@config/(.*)": "<rootDir>/config/$1",
      "^@global/(.*)": "<rootDir>/global/$1",
      "^@swagger/(.*)": "<rootDir>/swagger/$1",
      "^@users/(.*)": "<rootDir>/users/$1"
    }
  }
}
