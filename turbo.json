{
    "globalDependencies": ["**/.env.*local"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", ".next/**", "build/**"]
        },
        "lint": {},
        "test": {
            "dependsOn": ["build"],
            "outputs": ["coverage/**"],
            "inputs": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts"]
        },
        "test:e2e": {
            "cache": false,
            "dependsOn": ["build"],
            "env": ["DB_HOST", "DB_PORT", "DB_USERNAME", "DB_PASSWORD", "REDIS_HOST", "REDIS_PORT"]
        },
        "typecheck": {
            "outputs": []
        },
        "format": {
            "dependsOn": [],
            "outputs": []
        },
        "format:check": {
            "dependsOn": [],
            "outputs": []
        },
        "dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "seed:demo": {
            "cache": false,
            "interactive": true
        },
        "clean": {
            "cache": false
        }
    }
}
